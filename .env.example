# Whisper Server Configuration

# Model settings: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=base

# Device: auto, cpu, cuda
WHISPER_DEVICE=auto

# Compute type: auto, int8, float16, float32, int8_float16
# On CPU: int8 or float32. On CUDA: float16 or int8_float16
WHISPER_COMPUTE_TYPE=auto

# Number of CPU threads for CTranslate2 (0 = auto based on CPU cores)
WHISPER_CPU_THREADS=4

# Custom model cache directory (optional)
# WHISPER_DOWNLOAD_ROOT=./models

# Server settings
HOST=0.0.0.0
PORT=8000

# Optional API Key for security (leave empty to disable authentication)
API_KEY=
